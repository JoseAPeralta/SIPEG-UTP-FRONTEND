{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "backend-api": {
      "path": "../SIPEG-UTP-BACKEND",
      "description": "Read-only reference for the SIPEG backend. Never modify backend files from frontend tasks. Query the live API contract through pnpm run api:contract instead of loading the complete OpenAPI document."
    }
  },
  "mcp": {
    "storybook": {
      "type": "remote",
      "url": "http://127.0.0.1:6006/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 10000
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "ask",
      "git push *": "deny",
      "git push": "deny",
      "git fetch *": "deny",
      "git fetch": "deny",
      "git pull *": "deny",
      "git pull": "deny",
      "git remote *": "deny",
      "git remote": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git whatchanged": "allow",
      "git whatchanged *": "allow",
      "git shortlog": "allow",
      "git shortlog *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git diff *--output*": "deny",
      "git diff *--ext-diff*": "deny",
      "git diff *--textconv*": "deny",
      "git blame": "allow",
      "git blame *": "allow",
      "git diff-tree": "allow",
      "git diff-tree *": "allow",
      "git rev-list": "allow",
      "git rev-list *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git cat-file": "allow",
      "git cat-file *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git ls-tree": "allow",
      "git ls-tree *": "allow",
      "git show-ref": "allow",
      "git show-ref *": "allow",
      "git for-each-ref": "allow",
      "git for-each-ref *": "allow",
      "git merge-base": "allow",
      "git merge-base *": "allow",
      "git name-rev": "allow",
      "git name-rev *": "allow",
      "git describe": "allow",
      "git describe *": "allow",
      "git check-ignore": "allow",
      "git check-ignore *": "allow",
      "git grep": "allow",
      "git grep *": "allow",
      "git version": "allow",
      "git symbolic-ref": "allow",
      "git symbolic-ref -q": "allow",
      "git symbolic-ref -q *": "allow",
      "git symbolic-ref --short": "allow",
      "git symbolic-ref --short *": "allow",
      "git reflog": "allow",
      "git reflog show": "allow",
      "git reflog show *": "allow",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -v": "allow",
      "git branch -l": "allow",
      "git branch -l *": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git branch --all": "allow",
      "git branch --remotes": "allow",
      "git branch --show-current": "allow",
      "git tag": "allow",
      "git tag -l": "allow",
      "git tag -l *": "allow",
      "git tag --list": "allow",
      "git tag --list *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git worktree list": "allow",
      "git worktree list *": "allow",
      "git submodule status": "allow",
      "git submodule status *": "allow",
      "git config -l": "allow",
      "git config -l *": "allow",
      "git config --list": "allow",
      "git config --list *": "allow",
      "git config --get *": "allow",
      "git config --get-all *": "allow",
      "git config --get-regexp *": "allow",
      "*SIPEG-UTP-BACKEND*": "deny"
    },
    "edit": {
      "*": "allow",
      "*SIPEG-UTP-BACKEND*": "deny"
    }
  }
}
