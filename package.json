{
  "name": "sipeg-utp-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12.5.1 <13"
  },
  "scripts": {
    "api:contract": "node scripts/query-api-contract.mjs",
    "api:mocks-check": "node scripts/check-mock-contract.mjs",
    "build": "pnpm run typecheck && vite build",
    "audit": "pnpm audit --audit-level high",
    "check": "pnpm run format:check && pnpm run lint && pnpm test && pnpm run build && pnpm run test:storybook && pnpm run components:inventory:check",
    "components:inventory": "pnpm run storybook:build && pnpm run components:inventory:generate",
    "components:inventory:check": "node scripts/generate-component-inventory.mjs --check",
    "components:inventory:generate": "node scripts/generate-component-inventory.mjs",
    "dev": "vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "start": "vite preview --host 0.0.0.0",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:dev:ci": "storybook dev -p 6006 --ci --no-open",
    "storybook:list-stories": "node scripts/run-storybook-tests.mjs --list",
    "storybook:serve": "http-server storybook-static -a 127.0.0.1 -p 6007 -s",
    "storybook:test:affected": "node scripts/run-storybook-tests.mjs",
    "storybook:test:runner": "test-storybook --url http://127.0.0.1:6007 --ci",
    "storybook:test:suite": "pnpm run storybook:test:runner && pnpm run storybook:test:visual",
    "storybook:test:visual": "playwright test --config playwright.storybook.config.ts",
    "storybook:test:visual:update": "playwright test --config playwright.storybook.config.ts --update-snapshots",
    "test": "vitest run",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:harness": "sh scripts/prepare-agent-workspace.test.sh && sh scripts/run-agent-sandbox.test.sh",
    "test:related": "vitest related --run",
    "test:storybook": "pnpm run storybook:build && start-server-and-test storybook:serve http://127.0.0.1:6007 storybook:test:suite",
    "test:storybook:update": "pnpm run storybook:build && start-server-and-test storybook:serve http://127.0.0.1:6007 storybook:test:visual:update",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/query-sync-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "start-server-and-test": "^3.0.12",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.147.0"
  }
}
