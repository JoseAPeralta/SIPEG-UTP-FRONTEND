# Origen de datos del frontend.
# Por defecto se usa la API real; los mocks quedan reservados para tests, Storybook y offline.
# VITE_DATA_SOURCE=mock
# URL base del API: solo el origin, sin sufijo /api, porque los endpoints ya incluyen /api/v1.
# VITE_API_BASE_URL=http://localhost:3000

# Persistencia offline de la cache de TanStack Query (PWA). Desactivada por defecto.
# "on" persiste unicamente el catalogo publico; nunca operaciones ni datos de sesion.
# VITE_QUERY_PERSISTENCE=on

# Version de build para invalidar la cache persistida en cada despliegue.
# VITE_APP_VERSION=2026.09.25
